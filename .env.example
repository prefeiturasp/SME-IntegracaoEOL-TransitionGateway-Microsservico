DJANGO_SECRET_KEY=django-inseguro-apenas-desenvolvimento
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

API_KEY=trocar_esta_chave_em_ambiente_real
API_KEY_HEADER=X-API-Key

SIDECAR_PEDAGOGICO_URL=localhost
SIDECAR_PEDAGOGICO_API_KEY=
SIDECAR_PEDAGOGICO_API_KEY_HEADER=X-API-Key

SIDECAR_PROFESSORES_URL=localhost
SIDECAR_PROFESSORES_API_KEY=
SIDECAR_PROFESSORES_API_KEY_HEADER=X-API-Key

SIDECAR_PROGRAMASEDU_URL=localhost
SIDECAR_PROGRAMASEDU_API_KEY=
SIDECAR_PROGRAMASEDU_API_KEY_HEADER=X-API-Key

SIDECAR_INSTITUCIONAL_URL=localhost
SIDECAR_INSTITUCIONAL_API_KEY=
SIDECAR_INSTITUCIONAL_API_KEY_HEADER=X-API-Key

PORT_WEB=porta

SME_SERVICE_NAME=transition-gateway
SME_SERVICE_VERSION=0.1.0
SME_ENVIRONMENT=local
SME_TIMEOUT_SECONDS=10
SME_LOG_LEVEL=INFO
SME_LOG_FORMAT=json
SME_CORRELATION_ID_HEADER=X-Request-ID

SME_OTEL_ENABLED=true
SME_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8200
SME_OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20token
SME_OTEL_EXPORTER_OTLP_INSECURE=true

SME_RABBITMQ_URL=amqp://usuario:senha@localhost:5672/%2F
SME_LOG_RABBITMQ_QUEUE=
