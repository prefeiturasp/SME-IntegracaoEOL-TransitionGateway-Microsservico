DJANGO_SECRET_KEY=django-inseguro-apenas-desenvolvimento
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

API_KEY=trocar_esta_chave_em_ambiente_real
API_KEY_HEADER=X-API-Key

PEDAGOGICO_API_URL=localhost
PEDAGOGICO_API_KEY=
PEDAGOGICO_API_KEY_HEADER=X-API-Key

PROFESSORES_API_URL=localhost
PROFESSORES_API_KEY=
PROFESSORES_API_KEY_HEADER=X-API-Key

PROGRAMASEDU_API_URL=localhost
PROGRAMASEDU_API_KEY=
PROGRAMASEDU_API_KEY_HEADER=X-API-Key

INSTITUCIONAL_API_URL=localhost
INSTITUCIONAL_API_KEY=
INSTITUCIONAL_API_KEY_HEADER=X-API-Key

ALUNOS_API_URL=localhost
ALUNOS_API_KEY=
ALUNOS_API_KEY_HEADER=X-API-Key

PORT_WEB=porta

SME_SERVICE_NAME=transition-gateway
SME_SERVICE_VERSION=0.1.0
SME_ENVIRONMENT=local
SME_TIMEOUT_SECONDS=10
SME_LOG_LEVEL=INFO
SME_LOG_FORMAT=json
SME_CORRELATION_ID_HEADER=X-Request-ID

SME_OTEL_ENABLED=true
SME_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8200
SME_OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20token
SME_OTEL_EXPORTER_OTLP_INSECURE=true

SME_RABBITMQ_URL=amqp://usuario:senha@localhost:5672/%2F
SME_LOG_RABBITMQ_QUEUE=
